# Copy to .env (never commit it), then: set -a; source .env; set +a
GRIDPILOT_LOCAL=1
GRIDPILOT_PORT=8787
# Optional: where state/ and config-repo/ live (defaults to the repo folder)
# GRIDPILOT_HOME=/path/to/data
# Sponsor keys (optional; the simulator, finance desk and tests run without them)
CREAO_CLI_KEY=
CARTESIA_API_KEY=
# Public HTTPS URL that forwards to this server (e.g. cloudflared/ngrok), needed only so CREAO and Cartesia can call back
PUBLIC_BASE_URL=
